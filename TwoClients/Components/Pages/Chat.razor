@page "/chat"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using ChatApp.Shared
@using TwoClients.Services
@inject ChatApiClient Api
@implements IAsyncDisposable

<PageTitle>Chat</PageTitle>

@if (!_joined)
{
    <h3>Enter your username</h3>
    <div class="mb-2">
        <input class="form-control" style="max-width:300px"
               placeholder="Username (required)"
               @bind="_username" @bind:event="oninput"
               @onkeydown="OnUsernameKeyDown" />
    </div>
    <button class="btn btn-primary" @onclick="JoinAsync"
            disabled="@string.IsNullOrWhiteSpace(_username)">
        Join chat
    </button>
}
else
{
    <h3>Chat – you are <strong>@_username</strong></h3>

    <div style="border:1px solid #ccc; height:350px; overflow-y:auto; padding:8px; margin-bottom:8px;">
        @foreach (var m in _messages)
        {
            <div>
                <small class="text-muted">@m.SentAtUtc.ToLocalTime().ToString("HH:mm")</small>
                <strong>@m.User:</strong> @m.Text
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <input class="form-control" placeholder="Type a message..."
               @bind="_input" @bind:event="oninput"
               @onkeydown="OnMessageKeyDown" />
        <button class="btn btn-primary" @onclick="SendAsync"
                disabled="@string.IsNullOrWhiteSpace(_input)">
            Send
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <p class="text-danger mt-2">@_error</p>
}

@code {
    private HubConnection? _hub;
    private readonly List<ChatMessage> _messages = new();
    private string _username = "";
    private string _input = "";
    private string _error = "";
    private bool _joined;

    private async Task JoinAsync()
    {
        if (string.IsNullOrWhiteSpace(_username)) return;

        try
        {
            // 1. Load history through the API
            _messages.AddRange(await Api.GetMessagesAsync());

            // 2. Listen for live messages through the hub
            _hub = new HubConnectionBuilder()
                .WithUrl(Api.HubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hub.On<ChatMessage>(ChatRoutes.ReceiveMethod, message =>
            {
                _messages.Add(message);
                InvokeAsync(StateHasChanged);
            });

            await _hub.StartAsync();
            _joined = true;
            _error = "";
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the server: {ex.Message}";
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var text = _input;
        _input = "";

        var ok = await Api.SendAsync(_username.Trim(), text);
        _error = ok ? "" : "Message could not be sent.";
    }

    private async Task OnUsernameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await JoinAsync();
    }

    private async Task OnMessageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}